<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Lost & Found
			{% endblock %}
		</title>

		{# Bootstrap CDN #}
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

		{# Google Font Inter (optional) #}
		<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

		{# App CSS #}
		<link rel="stylesheet" href="{{ asset('css/app.css') }}"> {% block styles %}{% endblock %}
		</head>
		<body>
			<header class="site-navbar">
				<nav class="navbar navbar-expand-lg navbar-dark app-nav">
					<div class="container">

						<a class="navbar-brand fw-bold" href="{{ path('item_list') }}">
							Lost & Found
						</a>

						<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
							<span class="navbar-toggler-icon"></span>
						</button>

						<div class="collapse navbar-collapse" id="navbarNav">

							<ul class="navbar-nav me-auto mb-2 mb-lg-0">
								{% if app.user %}
									<li class="nav-item">
										<a class="nav-link {% if app.request.get('_route') starts with 'item_list' %}active{% endif %}" href="{{ path('item_list') }}">
											My Items
										</a>
									</li>
									<li class="nav-item">
										<a class="nav-link {% if app.request.get('_route') starts with 'item_new' %}active{% endif %}" href="{{ path('item_new') }}">
											New Item
										</a>
									</li>
								{% endif %}	
									<li class="nav-item">
									<a class="nav-link {% if app.request.get('_route') starts with 'item_browse' %}active{% endif %}" href="{{ path('item_browse') }}">
										Browse
									</a>
								</li>
							</ul>

							<ul class="navbar-nav">

								{% if app.user %}
									<li class="nav-item me-3 mt-2 text-white small">
										Hello,
										{{ app.user.email }}
									</li>

									<li class="nav-item">
										<a class="btn btn-sm btn-light px-3" href="{{ path('app_logout') }}">

											Logout
										</a>
									</li>

								{% else %}
									<li class="nav-item me-2">
										<a class="btn btn-sm btn-light px-3" href="{{ path('app_login') }}">
											Login
										</a>
									</li>

									<li class="nav-item">
										<a class="btn btn-sm btn-secondary px-3" href="{{ path('app_register') }}">
											Register
										</a>
									</li>
								{% endif %}

							</ul>
						</div>

					</div>
				</nav>


			</header>

			<main class="py-4">
				<div class="app-container">
					{% include 'partials/flash.html.twig' %}
					<h1 class="mb-4"> {% block page_title %}{% endblock %}
						</h1>

						{% block body %}{% endblock %}
					</div>
				</main>

				<footer class="py-4 text-center small text-muted">
					<div class="app-container">
						©
						{{ "now"|date("Y") }}
						Lost & Found
					</div>
				</footer>

				{% block scripts %}{% endblock %}
			</body>
		</html>

