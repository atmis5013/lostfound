{% extends 'base.html.twig' %}

{% block title %}Add New Item{% endblock %}

{% block body %}
  <div class="container mt-4">
    <h1>Add a Lost or Found Item</h1>

    {{ form_start(form) }}
      {{ form_widget(form) }}
      <button class="btn btn-primary mt-3">Save</button>
    {{ form_end(form) }}

    <a href="{{ path('item_list') }}" class="btn btn-link mt-3">View All Items</a>
  </div>
{% endblock %}
