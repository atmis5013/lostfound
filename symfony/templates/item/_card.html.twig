<div class="item-card mb-4">

	<h3>{{ item.title }}</h3>

	<div class="item-card-meta">
		<strong>{{ item.status|title }}</strong>
		<br>
		<small>{{ item.createdAt ? item.createdAt|date('Y-m-d') : '' }}</small>
	</div>

	<p>
		{{ item.description|length > 160 
            ? item.description|slice(0, 160) ~ '…' 
            : item.description 
        }}
	</p>

	<div class="item-card-footer">
<a href="{{ path('item_show', {'id': item.id}) }}" class="btn btn-primary me-2">


			View
		</a>

	{% if app.user and app.user == item.owner %}
		
			<a href="{{ path('item_edit', {'id': item.id}) }}" class="btn btn-secondary me-2">
				Edit
			</a>

			<form method="post" action="{{ path('item_delete', {'id': item.id}) }}" style="display:inline-block" onsubmit="return confirm('Are you sure?');">

				<input type="hidden" name="_token" value="{{ csrf_token('delete_item_' ~ item.id) }}">

				<button class="btn btn-danger">Delete</button>
			</form>
		
	{% endif %}

	</div>
</div>

