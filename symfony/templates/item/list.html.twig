{% extends 'base.html.twig' %}
{% block page_title %}
	<span class="fw-semibold">{{ block('title') }}</span>
{% endblock %}


{% block title %}My Items
{% endblock %}

{% block body %}
	<div class="row g-4">
		{% for item in items %}
			<div class="col-md-6 col-lg-4">
				{% include 'item/_card.html.twig' with { item: item } %}
			</div>
		{% else %}
			<p>You haven't added any items yet.</p>
		{% endfor %}
	</div>
{% endblock %}

