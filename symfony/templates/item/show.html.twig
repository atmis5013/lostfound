{% extends 'base.html.twig' %}

{% block title %}Item Details
{% endblock %}
{% block page_title %}
	<span class="fw-semibold">{{ item.title }}</span>
{% endblock %}

{% block body %}

	<div class="row justify-content-center">
		<div class="col-md-8">
			<div class="app-card">

				<h3 class="mb-4 fw-bold">{{ item.title }}</h3>

				<p class="text-muted small mb-4">
					Added on:
					{{ item.createdAt|date('Y-m-d H:i') }}
				</p>

				<div class="mb-3">
					<h6 class="fw-semibold">Description</h6>
					<p>{{ item.description }}</p>
				</div>

				<div class="mb-3">
					<h6 class="fw-semibold">Status</h6>
					<span class="badge bg-primary px-3 py-2">
						{{ item.status }}
					</span>
				</div>

				<hr>

				<div class="d-flex justify-content-between mt-4">

					<a href="{{ path('item_list') }}" class="btn btn-secondary">
						Back
					</a>

					<div>
                    {#
						<a href="{{ path('item_edit', {'id': item.id}) }}" class="btn btn-primary me-2">
							Edit
						</a>

						<a href="{{ path('item_delete', {'id': item.id}) }}" class="btn btn-danger" onclick="return confirm('Are you sure?');">
							Delete
						</a> 
                        #}
					</div>

				</div>

			</div>
		</div>
	</div>

{% endblock %}

