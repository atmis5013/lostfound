{% extends 'base.html.twig' %}

{% block title %}Item Details
{% endblock %}
{% block page_title %}
	<span class="fw-semibold">{{ item.title }}</span>
{% endblock %}

{% block body %}

	<div class="row justify-content-center">
		<div class="col-md-8">
			<div class="app-card">

				<h3 class="mb-4 fw-bold">{{ item.title }}</h3>

				<p class="text-muted small mb-4">
					Added on:
					{{ item.createdAt|date('Y-m-d H:i') }}
				</p>

				<div class="mb-3">
					<h6 class="fw-semibold">Description</h6>
					<p>{{ item.description }}</p>
				</div>

				<div class="mb-3">
					<h6 class="fw-semibold">Status</h6>
					<span class="badge bg-primary px-3 py-2">
						{{ item.status }}
					</span>
				</div>

				<hr>

				<div class="d-flex justify-content-between mt-4">

					<a href="{{ path('item_list') }}" class="btn btn-secondary">
						Back
					</a>

				{% if app.user and app.user == item.owner %}
					<div>
						<a href="{{ path('item_edit', {'id': item.id}) }}" class="btn btn-secondary me-2">
							Edit
						</a>

						<form method="post" action="{{ path('item_delete', {'id': item.id}) }}" style="display:inline-block" onsubmit="return confirm('Are you sure?');">

							<input type="hidden" name="_token" value="{{ csrf_token('delete_item_' ~ item.id) }}">

							<button class="btn btn-danger">Delete</button>
						</form>
					</div>
				{% endif %}


				</div>

			</div>
		</div>
	</div>

{% endblock %}

